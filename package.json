{
  "name": "dev-board",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "bin": {
    "devboard": "./bin/devboard.js",
    "devboard-mcp": "./bin/devboard-mcp.js",
    "dev-board": "./bin/devboard.js",
    "dev-board-mcp": "./bin/devboard-mcp.js"
  },
  "scripts": {
    "dev": "vite --port 4100",
    "build": "tsc && vite build && node scripts/build-binaries.js",
    "build:bin": "node scripts/build-binaries.js",
    "preview": "vite preview --port 4100",
    "import:dom": "node scripts/import-dom-docs.js",
    "test": "node scripts/test-parser.js && node --experimental-strip-types scripts/verify-integration.js",
    "test:backlog": "node --experimental-strip-types scripts/verify-integration.js",
    "mcp": "node bin/devboard-mcp.js",
    "tasks": "node --experimental-strip-types scripts/devboard-cli.ts list --open",
    "backlog:check": "node scripts/verify-backlog-sync.js",
    "backlog:sync": "node scripts/verify-backlog-sync.js --fix",
    "audit:ux": "node scripts/audit-ux-code.cjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}